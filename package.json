{
  "name": "agent-sessions",
  "displayName": "Agent Sessions",
  "description": "Browse OMP and Claude Code sessions. Files opened from a session use the comment view.",
  "version": "1.4.1",
  "publisher": "jinxinyang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentSessions.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentSessions.open",
        "title": "Sessions: Open Session Library"
      },
      {
        "command": "agentSessions.selectAll",
        "title": "Sessions: Select All in Input"
      }
    ],
    "keybindings": [
      {
        "command": "agentSessions.selectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "agentSessionsInputFocused"
      }
    ]
  },
  "dependencies": {
    "markdown-it": "^14.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zzz141592653/agent-sessions.git"
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
