{
  "name": "agent-sessions",
  "displayName": "Claude Code & OMP GUI — Sessions, Usage & Review",
  "description": "GUI for Claude Code and OMP (Oh My Pi): live session browser, Today/Month token & spend tracker with mascot toasts, Mermaid/SVG/table chart viewer, and inline file review comments.",
  "version": "1.5.2",
  "publisher": "jinxinyang",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "AI",
    "Chat",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude-code",
    "claude",
    "omp",
    "oh-my-pi",
    "gui",
    "sessions",
    "usage",
    "cost",
    "spend",
    "code-review",
    "dashboard",
    "cursor",
    "mermaid",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentSessions.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentSessions.open",
        "title": "Sessions: Open Session Library"
      },
      {
        "command": "agentSessions.selectAll",
        "title": "Sessions: Select All in Input"
      }
    ],
    "keybindings": [
      {
        "command": "agentSessions.selectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "agentSessionsInputFocused"
      }
    ]
  },
  "dependencies": {
    "markdown-it": "^14.3.2"
  },
  "homepage": "https://github.com/Zzz141592653/claude-omp-gui#readme",
  "bugs": {
    "url": "https://github.com/Zzz141592653/claude-omp-gui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zzz141592653/claude-omp-gui.git"
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package",
    "publish:ovsx": "npx ovsx publish -p \"$(tr -d '[:space:]' < ~/open-vsx.token)\""
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
